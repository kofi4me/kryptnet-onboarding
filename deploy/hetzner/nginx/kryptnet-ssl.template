server {
    listen 80;
    server_name kryptscan.kryptnet.org onboarding.kryptnet.org scanner.kryptnet.org;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name kryptscan.kryptnet.org onboarding.kryptnet.org;

    ssl_certificate /etc/letsencrypt/live/kryptscan.kryptnet.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kryptscan.kryptnet.org/privkey.pem;

    client_max_body_size 10m;

    location / {
        proxy_pass http://kryptnet-web:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 443 ssl;
    server_name scanner.kryptnet.org;

    ssl_certificate /etc/letsencrypt/live/kryptscan.kryptnet.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kryptscan.kryptnet.org/privkey.pem;

    client_max_body_size 2m;

    location /health {
        proxy_pass http://scanner-worker:9000/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        return 404;
    }
}
