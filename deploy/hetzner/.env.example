APP_NAME=KryptScan
APP_ENV=production
APP_SECRET=replace-with-long-random-secret
TRUSTED_HOSTS=kryptscan.kryptnet.org,onboarding.kryptnet.org,scanner.kryptnet.org,localhost,127.0.0.1
SESSION_COOKIE_SECURE=true

POSTGRES_DB=kryptnet
POSTGRES_USER=kryptnet
POSTGRES_PASSWORD=replace-with-long-random-db-password

KRYPTSCAN_DOMAIN=kryptscan.kryptnet.org
EMAIL_DELIVERY=smtp
EMAIL_FROM=support@kryptnet.org
SMTP_FROM_NAME=KryptNet
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

SCANNER_BACKEND=worker
SCANNER_WORKER_URL=http://scanner-worker:9000
SCANNER_WORKER_TOKEN=replace-with-long-random-worker-token
SCANNER_WORKER_TIMEOUT_SECONDS=900
SCANNER_TOOL_TIMEOUT_SECONDS=180
ALLOW_PRIVATE_NETWORK_TARGETS=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

KRYPTNET_PAYMENT_WEBHOOK_SECRET=replace-after-payment-api-is-ready
PAYMENT_DEMO_MODE=false
