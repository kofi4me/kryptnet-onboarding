SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_URL=sqlite:///kryptnet_onboarding.db
FLASK_ENV=development
FLASK_APP=app.py
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=replace-with-email-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=notifications@example.com
SMTP_FROM_NAME=KryptNet
ADMIN_NOTIFICATION_EMAIL=support@kryptnet.org

# KryptScan managed endpoint-agent release
KRYPTGUARD_CONSOLE_URL=https://kryptguard.kryptnet.org
KRYPTGUARD_AGENT_RELEASE_READY=false
KRYPTGUARD_AGENT_ALLOW_UNSIGNED_TESTING=false
KRYPTGUARD_AGENT_VERSION=0.5.0
KRYPTGUARD_AGENT_CHANNEL=stable
KRYPTGUARD_AGENT_PUBLISHED_AT=
KRYPTGUARD_AGENT_SETUP_URL=
KRYPTGUARD_AGENT_SETUP_SHA256=
KRYPTGUARD_AGENT_SETUP_SIZE_MB=150
KRYPTGUARD_AGENT_MSI_URL=
KRYPTGUARD_AGENT_MSI_SHA256=
KRYPTGUARD_AGENT_MSI_SIZE_MB=138
KRYPTGUARD_AGENT_SIGNED=false
