FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates curl git nmap nikto whatweb dnsutils \
      ruby ruby-dev build-essential python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir sslyze semgrep checkov wafw00f

COPY . .

EXPOSE 9000
CMD ["uvicorn", "scanner_worker.app:app", "--host", "0.0.0.0", "--port", "9000"]
